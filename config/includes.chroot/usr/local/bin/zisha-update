#!/usr/bin/env bash
# ==============================================================================
# Zisha OS — Over-The-Air (OTA) Feature & Security Updater
# Location: /usr/local/bin/zisha-update
# Pulls latest features directly from https://github.com/Shahinkhan098/Zisha-OS
# ==============================================================================
set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

REPO_URL="https://github.com/Shahinkhan098/Zisha-OS.git"
CACHE_DIR="/opt/zisha-os-ota"

echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}   Zisha OS — Over-The-Air (OTA) System & Feature Updater${NC}"
echo -e "${CYAN}======================================================================${NC}"

if [ "$(id -u)" -ne 0 ]; then
    echo -e "${YELLOW}Please run with sudo: sudo zisha-update${NC}"
    exit 1
fi

echo -e "${CYAN}[1/3] Updating Debian Security & System Packages...${NC}"
apt-get update && apt-get upgrade -y

echo -e "${CYAN}[2/3] Fetching Latest Zisha OS Features from GitHub (${REPO_URL})...${NC}"
if [ -d "$CACHE_DIR/.git" ]; then
    git -C "$CACHE_DIR" pull --ff-only origin main
else
    rm -rf "$CACHE_DIR"
    git clone --depth 1 "$REPO_URL" "$CACHE_DIR"
fi

echo -e "${CYAN}[3/3] Applying Updated Zisha OS Tools, Configs & Apps...${NC}"
cp -r "$CACHE_DIR/config/includes.chroot/"* /
chmod +x /usr/local/bin/zisha-*
sysctl --system >/dev/null 2>&1 || true

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN} [SUCCESS] Zisha OS is now up to date with your latest GitHub features!${NC}"
echo -e "${GREEN}======================================================================${NC}"
