#!/usr/bin/env bash
# ==============================================================================
# Zisha OS 1.0 — Google Antigravity IDE & CLI (agy) One-Click Installer
# Location: /usr/local/bin/zisha-install-antigravity
# ==============================================================================
set -euo pipefail

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${CYAN}======================================================================${NC}"
echo -e "${GREEN}   Zisha OS 1.0 — Google Antigravity (IDE & CLI) Setup${NC}"
echo -e "${CYAN}======================================================================${NC}"
echo ""

# 1. Check if Google Antigravity is already installed
echo -e "${CYAN}[1/2] Checking existing Google Antigravity installation...${NC}"
if command -v antigravity >/dev/null 2>&1 || [ -x "/opt/antigravity/antigravity" ]; then
    echo -e "${GREEN}[OK] Google Antigravity is already installed at $(command -v antigravity || echo '/opt/antigravity/antigravity').${NC}"
else
    echo -e "${YELLOW}[i] Google Antigravity is not yet installed locally.${NC}"
    echo -e "${CYAN}[2/2] Opening official Antigravity download & docs page...${NC}"
    if command -v google-chrome-stable >/dev/null 2>&1; then
        google-chrome-stable "https://antigravity.google" >/dev/null 2>&1 &
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "https://antigravity.google" >/dev/null 2>&1 || true
    fi
fi

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "  - Launch Antigravity Desktop / IDE : ${YELLOW}antigravity${NC} (or from Start Menu)"
echo -e "  - Official Docs & Linux Installer  : ${CYAN}https://antigravity.google/docs${NC}"
echo -e "${GREEN}======================================================================${NC}"
