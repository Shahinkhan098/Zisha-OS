#!/usr/bin/env bash
# ==============================================================================
# Zisha OS 1.0 — Offline Bangla Unicode (Avro/Nikosh) <-> Bijoy Converter Launcher
# Location: /usr/local/bin/zisha-bangla-converter
# ==============================================================================
set -e

APP_URL="file:///usr/share/zisha-os/bangla-converter/index.html"

if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$APP_URL"
elif command -v firefox >/dev/null 2>&1; then
    firefox "$APP_URL" &
elif command -v chromium >/dev/null 2>&1; then
    chromium "$APP_URL" &
else
    echo "Open $APP_URL in your web browser."
fi
