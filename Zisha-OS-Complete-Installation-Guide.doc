<title>Zisha OS 1.0 — সম্পূর্ণ নতুন ইনস্টলেশন গাইডলাইন</title>
<style>
  body { font-family: 'Segoe UI', 'Hind Siliguri', 'Nikosh', Arial, sans-serif; line-height: 1.6; color: #1e293b; padding: 30px; }
  h1 { color: #065f46; border-bottom: 2px solid #10b981; padding-bottom: 8px; font-size: 24pt; }
  h2 { color: #0f766e; border-bottom: 1px solid #cbd5e1; padding-bottom: 5px; margin-top: 25px; font-size: 16pt; }
  h3 { color: #1e3a8a; margin-top: 18px; font-size: 13pt; }
  .alert { background: #fef2f2; border-left: 4px solid #ef4444; padding: 12px 16px; margin: 15px 0; border-radius: 4px; }
  .tip { background: #f0fdf4; border-left: 4px solid #10b981; padding: 12px 16px; margin: 15px 0; border-radius: 4px; }
  code { background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-family: 'Courier New', monospace; font-size: 10.5pt; color: #0f172a; }
  pre { background: #0f172a; color: #38bdf8; padding: 14px; border-radius: 6px; font-family: 'Courier New', monospace; overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; margin: 15px 0; }
  th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; }
  th { background-color: #f8fafc; font-weight: bold; }
  ul, ol { padding-left: 25px; }
  li { margin-bottom: 8px; }
  kbd { background: #e2e8f0; border: 1px solid #94a3b8; border-radius: 3px; padding: 2px 6px; font-size: 9pt; }
</style>
